    if JUDGE_LOGPROBS:
        kw["logprobs"] = True; kw["top_logprobs"] = 5
    if "gemini" in MODEL.lower():
        kw.update(temperature=0.0, seed=42,
                  reasoning_effort=LANE["reasoning"], max_tokens=LANE["max_tokens"])
    else:  # gpt-family
        kw.update(reasoning_effort=LANE["reasoning"],
                  max_completion_tokens=LANE["max_tokens"])
    return kw
 
 
async def _judge_one_chunk(alert_text, risk_chunk, rid=None):
    """Judge one alert against a small chunk of risks. Returns list of verdict dicts.
    risk_chunk: list of (library_risk_id, risk_text). Retries + token refresh on 401."""
    payload = {"alert_text": alert_text,
               "risks": [{"library_risk_id": r, "risk_text": t} for r, t in risk_chunk]}
    messages = [{"role": "system", "content": RISK_SYSTEM_PROMPT},
                {"role": "user",   "content": json.dumps(payload, ensure_ascii=False)}]
    last_err = None
    for attempt in range(1, LANE["max_retries"] + 1):
        try:
            token = await tok.get()
            r = await oai.chat.completions.create(
                messages=messages,
                extra_headers={"Authorization": f"Bearer {token}"},   # gateway v2 auth
                **_judge_call_kwargs())
            u = r.usage
            RISK_USAGE_LOG.append({"in": u.prompt_tokens, "out": u.completion_tokens,
                                   "ts": time.time()})
            # one raw-response-log entry per successful call
            RAW_RESPONSE_LOG.append({
                "RECORD_ID": rid, "RUN_ID": RUN_ID, "model": MODEL,
                "run_comment": RUN_COMMENT, "attempt": attempt,
                "finish_reason": r.choices[0].finish_reason,
                "prompt_tokens": u.prompt_tokens, "completion_tokens": u.completion_tokens,
                "total_tokens": u.total_tokens, "num_candidates": len(risk_chunk),
                "error": None, "ts": time.time()})
            return json.loads(r.choices[0].message.content)["items"]
        except Exception as e:
            last_err = e
            # a 401 means the token went stale mid-flight -> force refresh and retry
            if "401" in str(e) or "unauth" in str(e).lower():
                await tok.invalidate()
            await asyncio.sleep(1.5 ** attempt)
    # all retries failed -> log once, emit ERROR rows so the batch never crashes
    RAW_RESPONSE_LOG.append({
        "RECORD_ID": rid, "RUN_ID": RUN_ID, "model": MODEL, "run_comment": RUN_COMMENT,
        "attempt": LANE["max_retries"], "finish_reason": None,
        "prompt_tokens": None, "completion_tokens": None, "total_tokens": None,
        "num_candidates": len(risk_chunk),
        "error": f"{type(last_err).__name__}: {last_err}", "ts": time.time()})
    return [{"library_risk_id": r, "decision": "ERROR", "relevance_score": 0,
             "reasoning": f"n/a: {last_err}"} for r, _ in risk_chunk]
 
 
async def run_risk_linkage(candidates_by_record, alert_text_by_id, risk_text_by_id):
    """Judge every record's candidate risks, concurrently and in small chunks.
 
    Output: DataFrame[RECORD_ID, LIB_RISK, decision, relevance_score, reasoning].
 
    Speed design: one asyncio task per (record, chunk); a semaphore caps how many
    run at once; each response is small (chunk size) so latency per call stays low.
    """
    sem   = asyncio.Semaphore(LANE["concurrency"])
    chunk = LANE["chunk"]
 
    work = []
    for rid, risk_ids in candidates_by_record.items():
        pairs = [(c, risk_text_by_id[c]) for c in risk_ids if c in risk_text_by_id]
        for i in range(0, len(pairs), chunk):
            work.append((rid, pairs[i:i + chunk]))
 
    async def _one(rid, risk_chunk):
        async with sem:                                     # cap concurrency
            items = await _judge_one_chunk(alert_text_by_id[rid], risk_chunk, rid=rid)
            got = {str(it.get("library_risk_id", "")).strip().upper(): it for it in items}
            rows = []
            # iterate the ORIGINAL chunk so we always emit a row per candidate,
            # even if the model skipped / reordered / hallucinated an id
            for cid, _ in risk_chunk:
                it = got.get(cid)
                rows.append({
                    "RECORD_ID":       rid,
                    "LIB_RISK":        cid,
                    "decision":        (it or {}).get("decision", "MISSING"),
                    "relevance_score": (it or {}).get("relevance_score", 0),
                    "reasoning":       (it or {}).get("reasoning"),
                })
            return rows
 
    tasks = [asyncio.create_task(_one(rid, ch)) for rid, ch in work]
    if not tasks:
        raise ValueError("run_risk_linkage: no work units -- candidates_by_record is empty. "
                         "Check the rwt -> RSM -> LR chain in build_risk_candidates.")
    out = []
    for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="judge chunks"):
        out += await fut
    return pd.DataFrame(out)
 
 
def build_risk_candidates(records, top_k=None):     # None = judge ALL linked-RSM risks
    """Build candidate library risks per record, scoped to the risks that sit
    under the record's LINKED RSMs (the cascade). Reuses embed_cache.
 
    Returns (candidates_by_record, alert_text_by_id, risk_text_by_id).
    """
    # 1. record -> its linked RSMs (from the previous run `rwt`)
    linked = rwt[rwt["final_decision"].astype(str).str.upper() == "LINKED"].copy()
    linked["RECORD_ID"] = _norm_id(linked["RECORD_ID"])
    rsms_by_record = {}
    for _, row in linked.iterrows():
        ids  = str(row.get("linked_rsm_ids", "") or "")
        rsms = {_norm_id(pd.Series([x]))[0] for x in re.split(r"[|,]", ids) if x.strip()}
        rsms_by_record.setdefault(row["RECORD_ID"], set()).update(rsms)
 
    # 2. RSM -> its library risks (from RegMap Extract3, via parentage)
    risks_by_rsm = parentage["rsm_to_risk"]
 
    # 3. risk text (Helios) + alert text (reuse the rich loader from the RSM lane)
    risk_text_by_id = dict(zip(helios["LIB_RISK"], helios["risk_text"]))
    alerts_df = load_alerts(set(records))
    alert_text_by_id = dict(zip(alerts_df["RECORD_ID"], alerts_df["alert_text"]))
 
    # 4. embed + order (ordering only; top_k=None judges everything)
    risk_ids_pool = [r for r in risk_text_by_id if risk_text_by_id[r]]
    risk_vecs = embed_cache(risk_ids_pool,
                            [risk_text_by_id[c] for c in risk_ids_pool],
                            "helios_library_risks")     # NEW cache tag -- do NOT reuse
    rpos = {r: i for i, r in enumerate(risk_ids_pool)}
 
    rec_list   = [r for r in records if r in alert_text_by_id]
    alert_vecs = embed_cache(rec_list,
                             [alert_text_by_id[r] for r in rec_list],
                             "alerts_risk_lane")        # NEW cache tag -- do NOT reuse
    apos = {r: i for i, r in enumerate(rec_list)}
 
    candidates_by_record = {}
    for rid in rec_list:
        child = []
        for rsm in rsms_by_record.get(rid, set()):
            child.extend(risks_by_rsm.get(rsm, []))
        child = [c for c in dict.fromkeys(child) if c in rpos]   # dedup + must have text
        if not child:
            continue
        # Already scoped to risks under this record's linked RSMs -> the candidate
        # set is bounded, so judge ALL of them (no top-k cap). This removes
        # retrieval as a confound: NOT_JUDGED can then only be a data gap. We
        # still order by cosine so the judge sees the most-relevant risks first.
        sims  = risk_vecs[[rpos[c] for c in child]] @ alert_vecs[apos[rid]]
        order = np.argsort(-sims) if top_k is None else np.argsort(-sims)[:top_k]
        candidates_by_record[rid] = [child[i] for i in order]
 
    if not candidates_by_record:
        raise ValueError(
            f"No candidates built. records with RSMs={len(rsms_by_record)}, "
            f"RSM overlap with Extract3="
            f"{len(set().union(*rsms_by_record.values()) & set(risks_by_rsm)) if rsms_by_record else 0}, "
            f"risks in pool={len(risk_ids_pool)}, alerts={len(rec_list)}")
 
    # --- upstream reachability: golden LRs reachable via the record's LINKED RSMs
    # This is the LR-lane analogue of the RSM lane's retrieval_recall. With
    # top_k=None there is no truncation, so a miss here is an UPSTREAM gap:
    # the risk's parent RSM was not LINKED, or RegMap has no RSM->LR row for it.
    golden_lrs_by_rec = (golden[~golden.LIB_RISK.isin(_BLANK)]
                           .groupby("RECORD_ID")["LIB_RISK"].apply(set).to_dict())
    g_total = g_reached = 0
    for rid in rec_list:
        gl = golden_lrs_by_rec.get(rid, set())
        g_total   += len(gl)
        g_reached += len(gl & set(candidates_by_record.get(rid, [])))
    RETRIEVAL_STATS["upstream_recall"] = g_reached / max(g_total, 1)
    print(f"[C] upstream recall (golden LR reachable via LINKED RSMs): "
          f"{g_reached:,}/{g_total:,} = {RETRIEVAL_STATS['upstream_recall']:.1%}")
 
    return candidates_by_record, alert_text_by_id, risk_text_by_id
 
 
# ---- Execute -----------------------------------------------------------------
