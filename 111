def review_cases(verdicts_df, golden_df, alert_text_by_id, risk_text_by_id,
                 which="FN", n=15, audited_df=None, only_bucket=None, seed=42, truncate=1600):
    """which : "FN" = golden-true but model NOT linked (are these correct rejections?)
               "FP" = model LINKED but not in golden   (are these real discoveries?)"""
    v = verdicts_df.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["DEC"] = v.decision.astype(str).str.upper()
    gsub = golden_df[~golden_df.LIB_RISK.isin(_BLANK)]
    gk = set(gsub.RECORD_ID + "|" + gsub.LIB_RISK)
    v["key"] = v.REC + "|" + v.RISK; v["golden"] = v.key.isin(gk)
 
    sel = (v[(v.golden) & (v.DEC != "LINKED")] if which == "FN"
           else v[(~v.golden) & (v.DEC == "LINKED")])
 
    if audited_df is not None:
        a = audited_df[["REC", "RISK", "audit_category", "sub_reason",
                        "one_line_explanation"]].copy()
        sel = sel.merge(a, on=["REC", "RISK"], how="left")
        if only_bucket:
            sel = sel[sel.audit_category == only_bucket]
 
    if len(sel) == 0:
        print("No cases match."); return sel
    sel = sel.sample(min(n, len(sel)), random_state=seed).reset_index(drop=True)
 
    for _, r in sel.iterrows():
        print("=" * 110)
        head = f"RECORD {r.REC}  |  RISK {r.RISK}  |  model={r.DEC}  |  golden_linked={r.golden}"
        if "audit_category" in sel.columns:
            head += f"  |  audit={r.get('audit_category')}/{r.get('sub_reason')}"
        print(head); print("-" * 110)
        print("ALERT TEXT:\n", (alert_text_by_id.get(r.REC, "") or "")[:truncate])
        print("-" * 110)
        print("RISK TEXT:\n",  (risk_text_by_id.get(r.RISK, "") or "")[:truncate])
        print("-" * 110)
        print("MODEL REASONING:", r.get("reasoning"))
        if "one_line_explanation" in sel.columns:
            print("AUDIT SAYS     :", r.get("one_line_explanation"))
        print()
    return sel
 
 
