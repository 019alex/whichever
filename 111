#%% ==============================================================
# Entity mapper: PROD vs UAT reference-data comparison
# Goal: evidence that LOB / LE / GEO keys (and the LOB->L2, LOB->GEO mappings)
#       are not the same between the PROD and UAT extracts
# ==============================================================
import numpy as np
import pandas as pd
 
PROD_PATH = r"C:\Users\45216781\Downloads\V_API_OPR_RISK_BUS_GEO_HIER.xlsx"
UAT_PATH  = r"C:\Users\45216781\Downloads\HZN_REF_KBD_MAPPER_DATA.csv"
OUT_PATH  = r"C:\Users\45216781\Downloads\entity_mapper_PROD_vs_UAT_evidence.xlsx"
 
STATUS_COL = "ENTITY_MAPPER_STATUS"   # used for the mapping-level test (section 5) only
N_EX = 25                             # examples printed per check
 
DIMS = {  # name: (key, path, level, L2 text)
    "LOB": ("BUS_LINE_KEY",  "BUS_LINE_PATH_TEXT",  "BUS_LINE_LEVEL",  "BUS_LINE_L2_TEXT"),
    "LE":  ("LEGL_HIER_KEY", "LEGL_HIER_PATH_TEXT", "LEGL_HIER_LEVEL", "LEGL_HIER_L2_TEXT"),
    "GEO": ("GEO_HIER_KEY",  "GEO_HIER_PATH_TEXT",  "GEO_HIER_LEVEL",  "GEO_HIER_L2_TEXT"),
}
STATUS_COLS = ["ENTITY_MAPPER_STATUS", "BUS_GEO_ENTITY_MAPPER_STATUS",
               "BUS_LEGL_ENTITY_MAPPER_STATUS", "GEO_LEGL_ENTITY_MAPPER_STATUS"]
NUM_COLS = [v[0] for v in DIMS.values()] + [v[2] for v in DIMS.values()] + ["UNIQUE_KEY"]
USECOLS  = set(NUM_COLS + [c for v in DIMS.values() for c in v] + STATUS_COLS
               + ["REC_END_DT", "TOTAL_COUNT", "RNK"])
 
pd.set_option("display.width", 250, "display.max_columns", 30, "display.max_colwidth", 70)
norm = lambda s: s.astype(str).str.casefold().str.replace(r"\s+", " ", regex=True).str.strip()
pct  = lambda a, b: round(100 * a / b, 1) if b else 0.0
 
#%% === 1. Load (all as string, needed columns only) ===
prod_cols = pd.read_excel(PROD_PATH, nrows=0).columns.str.strip().str.upper()
uat_cols  = pd.read_csv(UAT_PATH, nrows=0).columns.str.strip().str.upper()
 
pick = lambda c: c.strip().upper() in USECOLS
prod = pd.read_excel(PROD_PATH, dtype=str, usecols=pick)   # slow for ~1M rows; pickle it after first load
uat  = pd.read_csv(UAT_PATH, dtype=str, low_memory=False, usecols=pick)
 
for df in (prod, uat):
    df.columns = df.columns.str.strip().str.upper()
    for c in df.columns:
        df[c] = df[c].str.strip().replace("", np.nan)
    for c in NUM_COLS:
        df[c] = df[c].str.replace(r"\.0$", "", regex=True)          # "2991.0" -> "2991"
    f = df[["BUS_LINE_KEY", "LEGL_HIER_KEY", "GEO_HIER_KEY"]].notna()
    df["ROW_TYPE"] = (f["BUS_LINE_KEY"].map({True: "LOB+", False: ""})
                      + f["LEGL_HIER_KEY"].map({True: "LE+", False: ""})
                      + f["GEO_HIER_KEY"].map({True: "GEO", False: ""})).str.rstrip("+")
    df["IS_CURRENT"] = df["REC_END_DT"].str.contains("9999", na=False)
 
#%% === 2. Extract completeness + schema ===
tc = pd.to_numeric(prod.get("TOTAL_COUNT"), errors="coerce").max()
print(f"PROD rows: {len(prod):,} | TOTAL_COUNT in file: {tc:,.0f} | max RNK: {pd.to_numeric(prod['RNK'], errors='coerce').max():,.0f}")
print(f"UAT  rows: {len(uat):,} | max RNK: {pd.to_numeric(uat['RNK'], errors='coerce').max():,.0f}")
if pd.notna(tc) and len(prod) < tc:
    print(f"\n*** WARNING: PROD extract holds {len(prod):,} of {tc:,.0f} rows (Excel row cap?). "
          "'Only in UAT' counts are NOT reliable. Lead with the same-node/different-key metrics. ***")
print("\nColumns only in PROD:", sorted(set(prod_cols) - set(uat_cols)))
print("Columns only in UAT :", sorted(set(uat_cols) - set(prod_cols)))
 
#%% === 3. Row type / status profile ===
status_tbls = []
for name, df in (("PROD", prod), ("UAT", uat)):
    print(f"\n--- {name}: row type x current record ---")
    print(pd.crosstab(df["ROW_TYPE"], df["IS_CURRENT"], margins=True))
    for s in STATUS_COLS:
        t = pd.crosstab(df.loc[df["IS_CURRENT"], "ROW_TYPE"], df.loc[df["IS_CURRENT"], s].fillna("<null>"))
        print(f"\n{name} | current rows | {s}:\n{t}")
        status_tbls.append(t.reset_index().assign(ENV=name, STATUS_COL=s))
 
#%% === 4. Node level: same hierarchy node -> same key? (current rows, any status) ===
summary, sheets = [], {}
for dim, (k, path, lvl, l2) in DIMS.items():
    nodes = {}
    for name, df in (("PROD", prod), ("UAT", uat)):
        n = df.loc[df["IS_CURRENT"], [k, path, lvl, l2]].dropna(subset=[k, path]).drop_duplicates()
        n["NODE"] = norm(n[path])
        print(f"{dim} {name}: keys with >1 path = {(n.groupby(k)['NODE'].nunique() > 1).sum()}, "
              f"paths with >1 key = {(n.groupby('NODE')[k].nunique() > 1).sum()}")
        nodes[name] = n.drop_duplicates(k).drop_duplicates("NODE")
    p, u = nodes["PROD"], nodes["UAT"]
 
    # A) join on node name (path) -> compare keys
    by_name = p.merge(u, on="NODE", how="outer", suffixes=("_PROD", "_UAT"), indicator=True)
    both    = by_name[by_name["_merge"] == "both"]
    re_keyed = both[both[f"{k}_PROD"] != both[f"{k}_UAT"]]
 
    # B) join on key -> compare node name and L2 (same key, different meaning)
    by_key  = p.merge(u, on=k, suffixes=("_PROD", "_UAT"))
    collide = by_key[by_key["NODE_PROD"] != by_key["NODE_UAT"]]
    l2_diff = by_key[norm(by_key[f"{l2}_PROD"].fillna("")) != norm(by_key[f"{l2}_UAT"].fillna(""))]
 
    summary.append({
        "dimension": dim, "nodes_PROD": len(p), "nodes_UAT": len(u),
        "nodes_in_both_by_name": len(both),
        "same_node_same_key": len(both) - len(re_keyed),
        "same_node_DIFFERENT_key": len(re_keyed),
        "pct_shared_nodes_rekeyed": pct(len(re_keyed), len(both)),
        "keys_in_both": len(by_key),
        "same_key_DIFFERENT_node": len(collide),
        "same_key_DIFFERENT_L2": len(l2_diff),
        "pct_PROD_keys_resolving_correctly_in_UAT": pct(len(by_key) - len(collide), len(p)),
        "nodes_only_PROD": int((by_name["_merge"] == "left_only").sum()),
        "nodes_only_UAT": int((by_name["_merge"] == "right_only").sum()),
    })
 
    delta = pd.to_numeric(re_keyed[f"{k}_UAT"], errors="coerce") - pd.to_numeric(re_keyed[f"{k}_PROD"], errors="coerce")
    print(f"\n{dim}: most common key offset (UAT - PROD) among re-keyed nodes:\n{delta.value_counts().head(5)}")
    print(f"\n{dim}: same node, different key\n"
          f"{re_keyed[[f'{path}_PROD', f'{k}_PROD', f'{k}_UAT']].head(N_EX).to_string(index=False)}")
    if len(collide):
        print(f"\n{dim}: same key, different node\n"
              f"{collide[[k, f'{path}_PROD', f'{path}_UAT']].head(N_EX).to_string(index=False)}")
 
    lvl2 = by_name[(by_name[f"{lvl}_PROD"] == "2") | (by_name[f"{lvl}_UAT"] == "2")]
    lvl2 = lvl2.assign(SAME_KEY=lvl2[f"{k}_PROD"] == lvl2[f"{k}_UAT"])
    lvl2 = lvl2[[f"{path}_PROD", f"{path}_UAT", f"{k}_PROD", f"{k}_UAT", "SAME_KEY", "_merge"]]
    print(f"\n{dim}: level-2 nodes (model granularity)\n{lvl2.head(60).to_string(index=False)}")
 
    sheets[f"{dim}_crosswalk"] = by_name.drop(columns="NODE")
    sheets[f"{dim}_level2"] = lvl2
    sheets[f"{dim}_key_collisions"] = collide.drop(columns=["NODE_PROD", "NODE_UAT"])
 
#%% === 5. Mapping level: are LOB->GEO and LOB->LE relationships the same? (current + Active) ===
pair_rows = []
for a, b in (("LOB", "GEO"), ("LOB", "LE")):
    ka, pa = DIMS[a][:2]
    kb, pb = DIMS[b][:2]
    sets = {}
    for name, df in (("PROD", prod), ("UAT", uat)):
        m = df[df["IS_CURRENT"] & df[STATUS_COL].str.casefold().eq("active")].dropna(subset=[ka, kb, pa, pb])
        sets[name] = m.assign(NA=norm(m[pa]), NB=norm(m[pb]))[["NA", "NB", ka, kb, pa, pb]].drop_duplicates(["NA", "NB"])
    P, U = sets["PROD"], sets["UAT"]
 
    j = P.merge(U, on=["NA", "NB"], suffixes=("_PROD", "_UAT"))
    j_diff = j[(j[f"{ka}_PROD"] != j[f"{ka}_UAT"]) | (j[f"{kb}_PROD"] != j[f"{kb}_UAT"])]
    key_hits = len(P[[ka, kb]].drop_duplicates().merge(U[[ka, kb]].drop_duplicates()))
 
    pair_rows.append({
        "mapping": f"{a} x {b}", "filter": f"current & {STATUS_COL}=Active",
        "pairs_PROD": len(P), "pairs_UAT": len(U),
        "PROD_pairs_in_UAT_by_NAME": len(j), "pct_by_NAME": pct(len(j), len(P)),
        "PROD_pairs_in_UAT_by_KEY": key_hits, "pct_by_KEY": pct(key_hits, len(P)),
        "name_match_but_keys_differ": len(j_diff),
    })
    print(f"\n{a} x {b}: pair matches by name but not by key\n"
          f"{j_diff[[f'{pa}_PROD', f'{pb}_PROD', f'{ka}_PROD', f'{ka}_UAT', f'{kb}_PROD', f'{kb}_UAT']].head(N_EX).to_string(index=False)}")
    sheets[f"{a}x{b}_name_ok_key_diff"] = j_diff.drop(columns=["NA", "NB", f"{pa}_UAT", f"{pb}_UAT"])
 
#%% === 6. GEO x LOB_L2 -> which LOB keys? (current + Active) ===
gk = {}
for name, df in (("PROD", prod), ("UAT", uat)):
    m = df[df["IS_CURRENT"] & df[STATUS_COL].str.casefold().eq("active")].dropna(
        subset=["BUS_LINE_KEY", "GEO_HIER_PATH_TEXT", "BUS_LINE_L2_TEXT"])
    gk[name] = (m.assign(GEO=m["GEO_HIER_PATH_TEXT"], LOB_L2=m["BUS_LINE_L2_TEXT"])
                 .groupby(["GEO", "LOB_L2"])["BUS_LINE_KEY"].agg(lambda s: ", ".join(sorted(set(s)))))
geo_l2 = pd.concat(gk, axis=1).reset_index()
geo_l2["STATUS"] = np.select([geo_l2["PROD"].isna(), geo_l2["UAT"].isna(), geo_l2["PROD"] == geo_l2["UAT"]],
                             ["only_UAT", "only_PROD", "same_keys"], "different_keys")
in_both = geo_l2["STATUS"].isin(["same_keys", "different_keys"]).sum()
n_diff  = (geo_l2["STATUS"] == "different_keys").sum()
print(f"\nGEO x LOB_L2 combos:\n{geo_l2['STATUS'].value_counts()}")
print(f"\nCombos in both envs: {in_both:,} | with different LOB keys: {n_diff:,} ({pct(n_diff, in_both)}%)")
print(f"\nExamples:\n{geo_l2[geo_l2['STATUS'] == 'different_keys'].head(N_EX).to_string(index=False)}")
 
#%% === 7. UNIQUE_KEY = concatenation of env-specific keys ===
for name, df in (("PROD", prod), ("UAT", uat)):
    bk, lk, gk = (df[c].fillna("") for c in ["BUS_LINE_KEY", "LEGL_HIER_KEY", "GEO_HIER_KEY"])
    chk = pd.DataFrame({"ROW_TYPE": df["ROW_TYPE"],
                        "LOB|LE|GEO": (bk + lk + gk) == df["UNIQUE_KEY"],
                        "LOB|GEO|LE": (bk + gk + lk) == df["UNIQUE_KEY"]})
    print(f"\n{name}: share of rows where UNIQUE_KEY == concatenated keys\n{chk.groupby('ROW_TYPE').mean().round(3)}")
uk_common = len(set(prod["UNIQUE_KEY"].dropna()) & set(uat["UNIQUE_KEY"].dropna()))
print(f"\nUNIQUE_KEY values common to PROD and UAT: {uk_common:,}")
 
#%% === 8. Summary + evidence workbook ===
summary = pd.DataFrame(summary)
pairs   = pd.DataFrame(pair_rows)
print("\n=== NODE-LEVEL SUMMARY ===\n", summary.set_index("dimension").T)
print("\n=== MAPPING-LEVEL SUMMARY ===\n", pairs.set_index("mapping").T)
print(f"\n=== GEO x LOB_L2: {n_diff:,} of {in_both:,} combos in both envs have different LOB keys ({pct(n_diff, in_both)}%) ===")
 
with pd.ExcelWriter(OUT_PATH) as xw:
    summary.to_excel(xw, sheet_name="summary_nodes", index=False)
    pairs.to_excel(xw, sheet_name="summary_mappings", index=False)
    geo_l2.to_excel(xw, sheet_name="GEOxL2_lob_keys", index=False)
    pd.concat(status_tbls).to_excel(xw, sheet_name="status_profile", index=False)
    for sh, d in sheets.items():
        d.to_excel(xw, sheet_name=sh[:31], index=False)
print(f"\nEvidence workbook written: {OUT_PATH}")
 




